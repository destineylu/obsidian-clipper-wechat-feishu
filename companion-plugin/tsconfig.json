{
	"compilerOptions": {
		"target": "ES2021",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"types": ["node", "obsidian"],
		"lib": ["ES2021", "DOM"]
	},
	"include": [
		"src/**/*.ts",
		"../src/platforms/feishu/bridge-protocol.ts",
		"../src/types/types.ts"
	],
	"exclude": ["src/**/*.test.ts"]
}
